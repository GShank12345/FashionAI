{
    "manifest_version": 3,
     "name": "Explore Fashion AI",
    "description": "Explore Fashion AI allows you to upload a picture of the. cloth and describes the shhen, texture and other realted information.",
    "version": "1.0",
   
    "host_permissions": [
     
    "http://localhost:3000/*",
     "http://localhost:3000/api/*"
  ],
    "icons": { "16": "icon16.png",
           "48": "icon48.png",
          "128": "icon128.png" },
      
        "action": {
            "default_icon": "icon.png",
            "default_popup": "mynotes.html"
        },
    
       "permissions": ["tts","storage"]

}
